{
  "name": "@zktx.io/walrus-connect",
  "description": "Walrus Connect QR/WebRTC route helpers and the reference Walrus Clip signer surface used by @zktx.io/walrus-wallet.",
  "keywords": [
    "sui",
    "wallet",
    "standard",
    "qr",
    "scan"
  ],
  "version": "0.4.0",
  "type": "module",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.esm.js"
    },
    "./signer-app": {
      "types": "./dist/types/signer-app.d.ts",
      "import": "./dist/signer-app.esm.js"
    },
    "./index.css": "./dist/index.css"
  },
  "typesVersions": {
    "*": {
      "signer-app": [
        "dist/types/signer-app.d.ts"
      ]
    }
  },
  "style": "dist/index.css",
  "sideEffects": [
    "*.css",
    "dist/index.css"
  ],
  "author": "daoauth",
  "license": "ISC",
  "scripts": {
    "clean": "rm -rf dist .rollup",
    "build": "npm run clean && tsc -p tsconfig.rollup.json && tsc -p tsconfig.json --emitDeclarationOnly && cp -R dist/types/walrus-connect/src/* dist/types/ && cp src/index.css .rollup/walrus-connect/src/index.css && rollup -c && node ../../scripts/prune-boundary-declarations.mjs walrus-connect && rm -rf .rollup",
    "lint": "npm run lint --prefix ../..",
    "format": "npm run format --prefix ../..",
    "test": "node --test test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zktx-io/walrus-clip-monorepo.git"
  },
  "bugs": {
    "url": "https://github.com/zktx-io/walrus-clip-monorepo/issues"
  },
  "homepage": "https://github.com/zktx-io/walrus-clip-monorepo#readme",
  "files": [
    "dist/index.esm.js",
    "dist/signer-app.esm.js",
    "dist/signTransactionReview-*.js",
    "dist/index.css",
    "dist/types/index.d.ts",
    "dist/types/signer-app.d.ts",
    "dist/types/types.d.ts",
    "dist/types/components/QRAddress.d.ts",
    "dist/types/components/QRAddressScan.d.ts",
    "dist/types/components/WalrusSignerScan.d.ts",
    "dist/types/utils/signTransactionReview.d.ts"
  ],
  "peerDependencies": {
    "@mysten/sui": "2.17.0",
    "@mysten/wallet-standard": "0.20.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "jiti": "^2.6.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-form": "^0.1.8",
    "@yudiel/react-qr-scanner": "^2.3.1",
    "lucide-react": "^0.544.0",
    "peerjs": "^1.5.5",
    "react-qrcode-logo": "^4.0.0"
  }
}
