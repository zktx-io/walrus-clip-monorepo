{
  "name": "@zktx.io/walrus-wallet",
  "description": "Air-gapped Sui Wallet Standard adapter that registers Walrus Clip and routes connect and sign-and-execute through QR/WebRTC.",
  "keywords": [
    "sui",
    "walrus",
    "wallet",
    "wallet standard",
    "qr",
    "air-gapped"
  ],
  "version": "0.4.2",
  "type": "module",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.esm.js"
    },
    "./index.css": "./dist/index.css"
  },
  "style": "dist/index.css",
  "sideEffects": [
    "*.css"
  ],
  "author": "daoauth",
  "license": "ISC",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && rollup -c && node ../../scripts/prune-boundary-declarations.mjs walrus-wallet",
    "lint": "npm run lint --prefix ../..",
    "format": "npm run format --prefix ../..",
    "test": "node --test test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zktx-io/walrus-clip-monorepo.git"
  },
  "bugs": {
    "url": "https://github.com/zktx-io/walrus-clip-monorepo/issues"
  },
  "homepage": "https://github.com/zktx-io/walrus-clip-monorepo#readme",
  "files": [
    "dist/index.esm.js",
    "dist/index.css",
    "dist/types/index.d.ts",
    "dist/types/runtime/walletErrors.d.ts",
    "dist/types/utils/coinHelpers.d.ts",
    "dist/types/utils/publicSuiClient.d.ts",
    "dist/types/utils/walletTypes.d.ts"
  ],
  "peerDependencies": {
    "@mysten/sui": "2.17.0",
    "@mysten/wallet-standard": "0.20.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@zktx.io/walrus-connect-route-internal": "file:../walrus-connect-route-internal",
    "jiti": "^2.6.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-form": "^0.1.8",
    "@radix-ui/react-use-size": "^1.1.1",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@yudiel/react-qr-scanner": "^2.3.1",
    "@zktx.io/walrus-connect": "0.4.2",
    "framer-motion": "^12.23.14",
    "lucide-react": "^0.544.0",
    "mitt": "^3.0.1",
    "react-qrcode-logo": "^4.0.0"
  }
}
